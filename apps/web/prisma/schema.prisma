generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

enum Role {
  ADMIN
  USER
}

model Host {
  id         String     @id @default(cuid())
  name       String     @unique
  token      String     @unique
  lastSeenAt DateTime?
  online     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  sessions   Session[]
}

model Profile {
  id        String    @id @default(cuid())
  name      String    @unique
  command   String
  args      String[]
  env       Json
  cwd       String?
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Session {
  id        String        @id @default(cuid())
  hostId    String
  profileId String
  userId    String
  status    SessionStatus @default(PENDING)
  pid       Int?
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  exitCode  Int?
  host      Host          @relation(fields: [hostId], references: [id])
  profile   Profile       @relation(fields: [profileId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  events    SessionEvent[]
}

enum SessionStatus {
  PENDING
  RUNNING
  EXITED
  ERROR
}

model SessionEvent {
  id        BigInt   @id @default(autoincrement())
  sessionId String
  ts        DateTime @default(now())
  kind      String
  data      Bytes
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, ts])
}
